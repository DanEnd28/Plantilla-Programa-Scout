# ── Base de datos (obligatoria) ─────────────────────────────────
# Neon (Vercel Marketplace) la crea sola como DATABASE_URL (conexión "pooled").
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require

# ── Claves (ver la matriz de permisos en DB-SETUP.md) ───────────
# READ_KEY:  para VER/listar programas. Vacía = cualquiera con el link puede ver.
READ_KEY=
# EDIT_KEY:  guardar con esta clave deja la versión "verificada".
#            Sin clave también se puede guardar: queda "sin verificar".
EDIT_KEY=
# ADMIN_KEY: superusuario. Archivar/desarchivar y borrar programas o versiones.
ADMIN_KEY=

# ── Ajustes (opcionales) ────────────────────────────────────────
# Tamaño máximo de un programa en bytes (Vercel acepta hasta 4,5 MB por petición).
# MAX_BODY_BYTES=3500000
# Conexiones por instancia de función.
# PG_POOL_MAX=5
